# Frontend environment configuration.
# Copy this file to `.env.local` and fill in the value.
# `.env.local` is git-ignored and MUST NOT be committed.

# Shared header sent by the proxy shim (as `X-App-Proxy`) so the backend can
# identify requests that originate from this app. It MUST match the backend
# `PROXY_HEADER` value in `backend/.env.local`.
# Generate a fresh random value, e.g.: openssl rand -hex 24
# NOTE: this value is inlined into the browser bundle at build time, so it is
# NOT a secret and is not a substitute for real authentication.
VITE_PROXY_HEADER="replace-with-a-random-value"
