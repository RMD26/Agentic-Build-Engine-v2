# Backend environment configuration.
# Copy this file to `.env.local` and fill in the values for your environment.
# `.env.local` is git-ignored and MUST NOT be committed (it can contain secrets).

# Host to listen on for the backend server.
# By default, listen only on localhost. This ensures the backend server is only
# accessible from the local proxy server. Changing this can expose the backend
# publicly — do so at your own risk.
API_BACKEND_HOST="127.0.0.1"

# Port to listen on for the backend server.
API_BACKEND_PORT=5000

# Max request payload size accepted by the backend server.
API_PAYLOAD_MAX_SIZE="7mb"

# Google Cloud project configuration.
GOOGLE_CLOUD_LOCATION="us-central1"
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"

# Shared header value used to identify requests coming from the Vertex App shim.
# Generate a fresh random value, e.g.: openssl rand -hex 24
# This MUST match VITE_PROXY_HEADER in frontend/.env.local.
# NOTE: because the frontend shim runs in the browser, this value is shipped to
# clients and is NOT a substitute for real authentication.
PROXY_HEADER="replace-with-a-random-value"
